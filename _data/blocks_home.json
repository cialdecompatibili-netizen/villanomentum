[
    {
        "id":  "hero",
        "nome":  "Hero",
        "enabled":  true,
        "html":  "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#15191d;--line:#dfe3d6;--warm:#f3f5ee;--muted:#4a5148;--y:#95d600;--gd:#3f6b00;--deep:#1d3a06;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#95d600;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#a9e81c}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - var(--mh,80px));min-height:calc(100svh - var(--mh,80px));padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.1rem,min(5.6vw,8.5vh),4.8rem);line-height:1.02;letter-spacing:-.01em;color:var(--ink);margin:0 0 clamp(1rem,3vh,1.75rem);max-width:15ch;text-wrap:balance}\n.ex-hero p{font-size:clamp(1rem,calc(.5vw + 1.4vh),1.35rem);line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 clamp(1.25rem,4vh,2.25rem)}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:calc(100svh - var(--mh,80px) - 4rem);display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#4a5148;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n.ex-hero{display:block;min-height:0;padding:clamp(3.5rem,9vw,7rem) 1.5rem}.ex-hero-in{display:block;max-width:1180px;margin:0 auto}.ex-hero h1{max-width:19ch}.ex-hero .ex-stats{flex-direction:row;flex-wrap:wrap;gap:1.25rem 2.5rem;margin:2.5rem 0 0;padding:0}.ex-hero .ex-stats li{min-width:9rem}.ex-list{margin:.75rem 0 0;padding:0;list-style:none}.ex-list li{padding:.4rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:1rem;line-height:1.5;margin:0}.ex-note{margin:2rem 0 0;font-size:1.05rem;line-height:1.6;color:var(--muted);max-width:60ch}.ex-hero{position:relative;overflow:hidden;background:#1d3a06;color:#fff;display:flex;align-items:center;min-height:min(88svh,780px)}.ex-hero-bg,.ex-hero-bg img{position:absolute;inset:0;width:100%;height:100%;display:block}.ex-hero-bg img{object-fit:cover;object-position:50% 55%}.ex-hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,25,5,.74) 0%,rgba(10,25,5,.48) 45%,rgba(10,25,5,.08) 100%)}.ex-hero-in{position:relative;z-index:1;width:100%}.ex-hero h1{color:#fff;text-shadow:0 2px 18px rgba(0,0,0,.35)}.ex-hero p{color:#f2f6ea;text-shadow:0 1px 10px rgba(0,0,0,.35)}.ex-hero .ex-btn-o{border-color:#fff;color:#fff}.ex-hero .ex-btn-o:hover{background:#fff;color:var(--ink)}.ex-hero .ex-stats li{border-top:1px solid rgba(255,255,255,.55)}.ex-hero .ex-num{color:var(--y)}.ex-hero .ex-lab{color:#eaf0e0}.ex-ph{margin:2.5rem 0 0;grid-column:1/-1}.ex-ph img{display:block;width:100%;height:clamp(220px,38vw,440px);object-fit:cover;border-radius:2px}@media (max-width:900px){.ex-hero::after{background:linear-gradient(180deg,rgba(10,25,5,.35) 0%,rgba(10,25,5,.78) 100%)}}</style><header class=\"ex-hero\" aria-label=\"Presentazione\"><picture class=\"ex-hero-bg\"><img src=\"__BASEURL__/assets/foto/casa-sulla-collina.jpg\" width=\"2200\" height=\"1467\" fetchpriority=\"high\" decoding=\"async\" alt=\"Colline con case e cipressi, paesaggio della campagna italiana\"></picture><div class=\"ex-hero-in\"><h1>Una villa con giardino a Mentana, per un weekend o per mesi.</h1><p>Tre piani indipendenti, ognuno con cucina e 6 posti letto. Scegli una camera, un piano o tutta la villa.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Chiedi disponibilit&agrave;</a><a class=\"ex-btn ex-btn-o\" href=\"#piani\">Scopri i piani</a></div><ul class=\"ex-stats\"><li><b class=\"ex-num\">3</b><span class=\"ex-lab\">piani abitabili, ognuno con cucina</span></li><li><b class=\"ex-num\">18</b><span class=\"ex-lab\">posti letto in tutta la villa</span></li><li><b class=\"ex-num\">300 m</b><span class=\"ex-lab\">dalla fermata del bus</span></li></ul></div></header><script>(function(){var m=document.querySelector(\".nv-header,.masthead\"),r=document.documentElement;function s(){if(m)r.style.setProperty(\"--mh\",Math.round(m.getBoundingClientRect().height)+\"px\")}s();if(window.ResizeObserver&&m)new ResizeObserver(s).observe(m);window.addEventListener(\"resize\",s);window.addEventListener(\"load\",s);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(s)})()</script>"
    },
    {
        "id":  "formule",
        "nome":  "Formule",
        "enabled":  true,
        "html":  "<section class=\"ex-sec\" id=\"formule\" aria-labelledby=\"formule-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"formule-title\">Come puoi soggiornare</h2><p class=\"ex-lead\">Una sola villa, quattro modi di viverla: per una notte, per un periodo lungo o tutta per voi.</p></div><ol class=\"ex-pts\"><li><b>B&amp;B con colazione</b><span>camera a notte con colazione inclusa, anche all'aperto in giardino.</span></li><li><b>Camere a notte</b><span>per turisti e viaggiatori di passaggio, a Mentana e a pochi chilometri da Roma.</span></li><li><b>Soggiorni lunghi</b><span>settimane o mesi, per studenti e smart worker, con cucina a disposizione.</span></li><li><b>Villa intera</b><span>tutti e tre i piani, 18 posti letto, su richiesta.</span></li></ol></div></section>"
    },
    {
        "id":  "piani",
        "nome":  "Piani e camere",
        "enabled":  true,
        "html":  "<section class=\"ex-sec ex-sec-warm\" id=\"piani\" aria-labelledby=\"piani-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"piani-title\">Tre piani, ognuno una casa</h2><div class=\"ex-grid3\"><div><h3>Primo piano</h3><ul class=\"ex-list\"><li>Salone e cucina</li><li>3 camere, 6 posti letto</li><li>2 bagni</li><li>Cantina</li></ul></div><div><h3>Secondo piano</h3><ul class=\"ex-list\"><li>Salone e cucina</li><li>3 camere, 6 posti letto</li><li>2 bagni</li><li>Cantina</li></ul></div><div><h3>Terzo piano</h3><ul class=\"ex-list\"><li>Salone e cucina</li><li>3 camere, 6 posti letto</li><li>2 bagni</li><li>Cantina</li></ul></div></div><p class=\"ex-note\">Ogni piano si pu&ograve; prenotare da solo, a camere o insieme agli altri: con tutta la villa si arriva a 18 posti letto.</p></div></section>"
    },
    {
        "id":  "giardino",
        "nome":  "Giardino",
        "enabled":  true,
        "html":  "<section class=\"ex-sec\" id=\"giardino\" aria-labelledby=\"giardino-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"giardino-title\">Il giardino</h2><p class=\"ex-lead\">Uno spazio all'aperto per tutti gli ospiti, da vivere dalla colazione alla sera.</p></div><ul class=\"ex-list\"><li>Tavoli per mangiare all'aperto</li><li>Barbecue</li><li>Zona relax</li><li>Parcheggio</li></ul><figure class=\"ex-ph\"><img src=\"__BASEURL__/assets/foto/colline-panorama.jpg\" width=\"1400\" height=\"935\" loading=\"lazy\" alt=\"Vista panoramica sulle colline dal giardino\"></figure></div></section>"
    },
    {
        "id":  "posizione",
        "nome":  "Dove siamo",
        "enabled":  true,
        "html":  "<section class=\"ex-sec ex-sec-warm\" id=\"posizione\" aria-labelledby=\"posizione-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"posizione-title\">Dove siamo</h2><p class=\"ex-lead\">A Mentana, in zona Mezzaluna, vicino a Roma.</p></div><ol class=\"ex-pts\"><li><b>Bus a 300 metri</b><span>la fermata &egrave; a pochi minuti a piedi dalla villa.</span></li><li><b>Zona residenziale</b><span>quartiere tranquillo, adatto sia a un soggiorno breve sia a vivere e lavorare per un periodo.</span></li></ol><figure class=\"ex-ph\"><img src=\"__BASEURL__/assets/foto/borgo-colline.jpg\" width=\"1400\" height=\"933\" loading=\"lazy\" alt=\"Tetti di un borgo e colline con cipressi\"></figure></div></section>"
    },
    {
        "id":  "richiesta",
        "nome":  "Richiesta",
        "enabled":  true,
        "html":  "<section class=\"ex-band\" id=\"richiesta\" aria-labelledby=\"richiesta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"richiesta-title\">Chiedi date e disponibilit&agrave;</h2><p>Dicci quando arrivi, in quanti siete e cosa cerchi: camera, piano o villa intera.</p></div><a class=\"ex-btn ex-btn-k\" href=\"__BASEURL__/contatti/\">Contattaci</a></div></section>"
    },
    {
        "id":  "perchi",
        "nome":  "Per chi",
        "enabled":  true,
        "html":  "<section class=\"ex-sec ex-sec-warm\" id=\"perchi\" aria-labelledby=\"perchi-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"perchi-title\">Per chi &egrave; la villa</h2><div class=\"ex-grid3\"><div><h3>Smart worker</h3><p>Una casa tranquilla dove lavorare per settimane o mesi, con cucina e giardino per le pause.</p><p style=\"margin-top:.75rem\"><a href=\"__BASEURL__/smart-worker/\">Soggiorni lunghi &rarr;</a></p></div><div><h3>Studentesse</h3><p>Una stanza in villa vicino a Roma, con cucina, salone e giardino dove studiare.</p><p style=\"margin-top:.75rem\"><a href=\"__BASEURL__/studentesse/\">Stanze per studentesse &rarr;</a></p></div><div><h3>Turisti</h3><p>B&amp;B o camera a notte, colazione in giardino e Roma a portata di bus.</p><p style=\"margin-top:.75rem\"><a href=\"__BASEURL__/turisti/\">Dormire a Mentana &rarr;</a></p></div></div></div></section>"
    }
]